[Unit]
Description=AMD Ryzen AI 7 350 Entropy-Driven Scheduler Arbiter (Rust Easy Mode)
After=default.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/bin/zen5 daemon --interval 0.4
Restart=always
RestartSec=2
CPUAffinity=1 3 5 7 9 11 13 15

[Install]
WantedBy=default.target
